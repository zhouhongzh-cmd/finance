# ============================================================
# 套利监控系统 - 环境变量配置模板
# 使用方法: cp .env.example .env 然后填写真实值
# ============================================================

# --- 通知渠道 ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx_api_key_xxx
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx_api_key_xxx

# --- 外部数据鉴权 ---
# 集思录 Cookie (用于突破 30 条数据限制，获取全市场 ~500+ 只转债)
# 获取方式: 浏览器登录 jisilu.cn 后 F12 → Network → 任意请求 → 复制 Cookie 请求头内容
JSL_COOKIE=""
# 雪球 Cookie (用于舆情/热度接口鉴权，未配置时相关抓取可能失败或降级)
# 获取方式: 浏览器登录 xueqiu.com 后 F12 → Network → 任意请求 → 复制 Cookie 请求头内容
XUEQIU_COOKIE=""

# --- 共享运行参数 ---
# 监控频率、模块开关、时间窗口、策略阈值、金属阈值都默认保存在仓库内的:
#   config/runtime_settings.json
#   config/metals_thresholds.json
# 这两个文件会随仓库同步。

# --- 可选覆盖项 ---
# 如果你想在某台机器上临时覆盖共享配置，可以直接编辑仓库里的 JSON 文件，
# 不建议再通过 .env 保存运行时参数。

# --- 网络参数 (可选，有默认值) ---
# REQUEST_TIMEOUT=15              # 单次请求超时（秒）
# RETRY_MAX_ATTEMPTS=3            # 最大重试次数

# --- IB Gateway / TWS (本机环境配置，不进入共享 runtime_settings.json) ---
# 默认 profile: remote | local
IB_DEFAULT_PROFILE=remote

# 远端测试网关
IB_REMOTE_HOST=100.99.204.61
IB_REMOTE_PORT=4001
IB_REMOTE_CLIENT_ID=60101

# 本机 IB Gateway / TWS
IB_LOCAL_HOST=127.0.0.1
IB_LOCAL_PORT=4002
IB_LOCAL_CLIENT_ID=60102

# API 等待超时（秒）
IB_GATEWAY_TIMEOUT_SECONDS=15
