# ============================================================
# 套利监控系统 - 环境变量配置模板
# 使用方法: cp .env.example .env 然后填写真实值
# ============================================================

# --- 通知渠道 ---
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx_api_key_xxx
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx_api_key_xxx

# --- 外部数据鉴权 ---
# 集思录 Cookie (用于突破 30 条数据限制，获取全市场 ~500+ 只转债)
# 获取方式: 浏览器登录 jisilu.cn 后 F12 → Network → 任意请求 → 复制 Cookie 请求头内容
JSL_COOKIE=""

# --- 调度参数 (可选，有默认值) ---
# THREAD_POOL_SIZE=20             # 并发线程池大小
# COOLDOWN_MINUTES=30             # 相同信号的报警冷却期（分钟）
# DATA_RETENTION_DAYS=30          # 历史报警与快照保留天数，调度器会在凌晨自动清理

# --- 策略开关 (可选，有默认值) ---
# ENABLE_FUTURES_MONITOR=true
# ENABLE_CONVERTIBLE_MONITOR=true
# ENABLE_SENTIMENT_MONITOR=true
# ENABLE_METALS_MONITOR=true

# --- 模块独立时钟 (可选，有默认值) ---
# FUTURES_CRUISE_INTERVAL_MINUTES=5
# FUTURES_WATCH_INTERVAL_SECONDS=30
# FUTURES_MORNING_START=09:30
# FUTURES_MORNING_END=11:30
# FUTURES_AFTERNOON_START=13:00
# FUTURES_AFTERNOON_END=15:00
# FUTURES_NIGHT_START=
# FUTURES_NIGHT_END=
#
# CONVERTIBLE_CRUISE_INTERVAL_MINUTES=5
# CONVERTIBLE_WATCH_INTERVAL_SECONDS=30
# CONVERTIBLE_MORNING_START=09:30
# CONVERTIBLE_MORNING_END=11:30
# CONVERTIBLE_AFTERNOON_START=13:00
# CONVERTIBLE_AFTERNOON_END=15:00
# CONVERTIBLE_NIGHT_START=
# CONVERTIBLE_NIGHT_END=
#
# SENTIMENT_CRUISE_INTERVAL_MINUTES=3
# SENTIMENT_MORNING_START=09:00
# SENTIMENT_MORNING_END=11:30
# SENTIMENT_AFTERNOON_START=13:00
# SENTIMENT_AFTERNOON_END=15:30
# SENTIMENT_NIGHT_START=
# SENTIMENT_NIGHT_END=
#
# METALS_CRUISE_INTERVAL_MINUTES=15
# METALS_WATCH_INTERVAL_SECONDS=60
# METALS_MORNING_START=09:00
# METALS_MORNING_END=11:30
# METALS_AFTERNOON_START=13:30
# METALS_AFTERNOON_END=15:00
# METALS_NIGHT_START=21:00
# METALS_NIGHT_END=02:30

# --- 网络参数 (可选，有默认值) ---
# REQUEST_TIMEOUT=15              # 单次请求超时（秒）
# RETRY_MAX_ATTEMPTS=3            # 最大重试次数

# --- 策略阈值 (可选，有默认值，可在此覆盖) ---
# CB_NEGATIVE_PREMIUM_THRESHOLD=0.0     # 转债负溢价阈值（%），低于此值触发报警
# CB_DOUBLE_LOW_THRESHOLD=130.0         # 双低值阈值，低于此值触发双低策略
# CB_YTM_THRESHOLD=2.0                  # 到期税前收益率下限（%），双低策略的防守过滤
# CB_SAFE_PRICE_THRESHOLD=130.0         # 负溢价策略的强赎安全红线（元）
# FUTURES_DISCOUNT_RATE_THRESHOLD=8.0   # 期指年化贴水率触发阈值（%）
# SENTIMENT_HOT_SCORE_THRESHOLD=5000000 # 舆情热度异常阈值
# SENTIMENT_PULSE_THRESHOLD=-0.8        # 舆情负面脉冲阈值

# --- 金属阈值 ---
# 金属套利的逐品种上下阈值不写入 .env
# GUI 会把它们写入 data/metals_thresholds.json
